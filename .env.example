# Backend Configuration
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# App environment: development | production (disables /docs, /redoc and /openapi.json)
ENVIRONMENT=development

# CORS Configuration
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare Turnstile CAPTCHA
ENABLE_TURNSTILLE_CAPTCHA=true
TURNSTILE_PUBLIC_KEY=
TURNSTILE_PRIVATE_KEY=

# Upload Configuration
UPLOAD_QUOTA_MB=20

# Google sign-in: OAuth 2.0 Web client ID (empty disables it)
GOOGLE_CLIENT_ID=

# AI assistant: key that encrypts users' provider API keys at rest
# (generate with openssl rand -hex 32; falls back to SECRET_KEY when empty)
AI_ENCRYPTION_KEY=
# Allow http:// and private-network base URLs for self-hosted models
AI_ALLOW_PRIVATE_BASE_URLS=false

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000
VITE_TURNSTILE_PUBLIC_KEY=

# Sessions: short-lived access token renewed by a rotating refresh token (HttpOnly cookies)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email verification with a one-time code sent through Resend (https://resend.com)
EMAIL_VERIFICATION_ENABLED=true
RESEND_API_KEY=
# Sender on a domain verified in Resend
EMAIL_FROM=LivePresentations <onboarding@resend.dev>
# Minutes a code is valid, seconds before another can be requested, wrong tries allowed
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Maximum simultaneous viewers of a public room
PUBLIC_ROOM_MAX_VIEWERS=300

# Contact address shown in the footer, the terms and the privacy policy
CONTACT_EMAIL=
