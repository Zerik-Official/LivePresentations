SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# App environment: development | production (disables /docs, /redoc and /openapi.json)
ENVIRONMENT=development
# DATABASE_URL=sqlite+aiosqlite:///./instance/livepresentations.db
# For Postgres: postgresql+asyncpg://user:password@localhost:5432/livepresentations
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_TURNSTILLE_CAPTCHA=true
TURNSTILE_PUBLIC_KEY=
TURNSTILE_PRIVATE_KEY=
UPLOAD_QUOTA_MB=20
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (empty disables it)
GOOGLE_CLIENT_ID=
# Key used to encrypt users' AI provider API keys at rest (generate with openssl rand -hex 32).
# Falls back to SECRET_KEY when empty; changing it makes stored keys unreadable.
AI_ENCRYPTION_KEY=
# Allow http:// and private-network base URLs for self-hosted models (never enable on a shared server)
AI_ALLOW_PRIVATE_BASE_URLS=false

# Sessions: short-lived access token renewed by a rotating refresh token (HttpOnly cookies)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email verification with a one-time code sent through Resend (https://resend.com)
EMAIL_VERIFICATION_ENABLED=true
RESEND_API_KEY=
# Sender on a domain verified in Resend
EMAIL_FROM=LivePresentations <onboarding@resend.dev>
# Minutes a code is valid, seconds before another can be requested, wrong tries allowed
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Maximum simultaneous viewers of a public room
PUBLIC_ROOM_MAX_VIEWERS=300
