# Leave empty to use the Vite development proxy.
VITE_BACKEND_URL=http://localhost:8000

# Public address of the site, used for canonical URLs (must match public/sitemap.xml).
VITE_SITE_URL=https://livepresentations.coderhivex.com

# Public Cloudflare Turnstile site key.
VITE_TURNSTILE_PUBLIC_KEY=ENTER_YOUR_PUBLIC_KEY_HERE